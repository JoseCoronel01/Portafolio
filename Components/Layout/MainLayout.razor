@inherits LayoutComponentBase

<PageTitle>Portafolio</PageTitle>

<div class="container">
    <h1>Mi Portafolio</h1>

    <div class="cards-grid">
        <a href="https://github.com/JoseCoronel01/SisGestion" target="_blank" class="card card-blue">
            <h3>SisGestion</h3>
            <p>Biblioteca de clases para la gestión de ingresos y egresos general.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/QueryObjectPattern" target="_blank" class="card card-purple">
            <h3>QueryObjectPattern</h3>
            <p>Ejemplo del patrón Query Object Pattern como hacer consultas SQL de una forma limpia y organizada.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/Sistema_Donaciones" target="_blank" class="card card-pink">
            <h3>Sistema_Donaciones</h3>
            <p>Sistema integral de gestión de donaciones en una organización.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/CitasApp" target="_blank" class="card card-green">
            <h3>CitasApp</h3>
            <p>Aplicación de gestión de citas, organiza tus eventos de la semana en un solo lugar.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/ScrumApp" target="_blank" class="card card-orange">
            <h3>ScrumApp</h3>
            <p>Aplicación de gestión de equipos de trabajo.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/Clinica" target="_blank" class="card card-teal">
            <h3>Clinica</h3>
            <p>Sistema integral de gestión de una clinica, lleva control de tratamiento de pacientes y pagos.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/CredencialesWeb" target="_blank" class="card card-red">
            <h3>CredencialesWeb</h3>
            <p>Sistema de gestión de credenciales.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/FinanzasPersonales" class="card card-indigo">
            <h3>Finanzas_Personales</h3>
            <p>Dashboard para moitorear tus finanzas personales.</p>
        </a>

        <a href="https://github.com/JoseCoronel01/TestApiRest" class="card card-yellow" style="display: none;">
            <h3>TestApiRest</h3>
            <p>Realiza los tests de tus endpoints.</p>
        </a>
    </div>
</div>

@Body
